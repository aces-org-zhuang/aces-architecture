// Cross-project views.
//
// These are the views the global layer owns. They describe relationships
// between systems, not the internals of any single system — internals stay in
// each project's own design repo.

views {
  view index {
    title 'ACES Platform Landscape'
    description 'All aggregated systems, actors and shared platforms'
    include *
  }

  view crossSystem {
    title 'Cross-System Relationships'
    description 'How aggregated systems depend on shared platforms'
    include operator, aces
    include wechatWork, ragflow, llmWiki
  }

  view sharedDependencies {
    title 'Shared Platform Dependencies'
    description 'Which systems depend on WeChat Work, RAGFlow and LLM Wiki'
    include aces.*
    include wechatWork, ragflow, llmWiki
  }
}
